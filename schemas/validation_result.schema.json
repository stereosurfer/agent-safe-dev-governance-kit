{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/stereosurfer/agent-safe-dev-governance-kit/schemas/validation_result.schema.json",
  "title": "ASGK validation-result envelope",
  "description": "Common evidence envelope for retained ASGK JSON validators. Additional top-level properties preserve command-specific payload.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "result",
    "evidence_source",
    "mechanically_checked",
    "not_checked",
    "human_gate",
    "proof_boundary",
    "findings"
  ],
  "properties": {
    "result": {
      "enum": [
        "pass",
        "fail",
        "blocked",
        "warning"
      ]
    },
    "evidence_source": {
      "$ref": "#/$defs/material_string"
    },
    "mechanically_checked": {
      "$ref": "#/$defs/material_string_list"
    },
    "not_checked": {
      "$ref": "#/$defs/material_string_list"
    },
    "human_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_checked",
            "not_applicable",
            "required"
          ]
        },
        "reason": {
          "$ref": "#/$defs/material_string"
        }
      }
    },
    "proof_boundary": {
      "$ref": "#/$defs/material_string"
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "result": {
            "const": "pass"
          }
        }
      },
      "then": {
        "properties": {
          "findings": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "const": "warning"
          }
        }
      },
      "then": {
        "properties": {
          "findings": {
            "minItems": 1,
            "items": {
              "allOf": [
                {
                  "$ref": "#/$defs/finding"
                },
                {
                  "properties": {
                    "blocking": {
                      "const": false
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "enum": [
              "fail",
              "blocked"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "findings": {
            "minItems": 1,
            "contains": {
              "properties": {
                "blocking": {
                  "const": true
                }
              },
              "required": [
                "blocking"
              ]
            },
            "minContains": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "human_gate": {
            "properties": {
              "status": {
                "const": "required"
              }
            },
            "required": [
              "status"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "const": "blocked"
          }
        }
      }
    }
  ],
  "$defs": {
    "material_string": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "material_string_list": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/material_string"
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "code",
        "reason",
        "blocking"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "field": {
          "$ref": "#/$defs/material_string"
        },
        "path": {
          "$ref": "#/$defs/material_string"
        },
        "reason": {
          "$ref": "#/$defs/material_string"
        },
        "blocking": {
          "type": "boolean"
        }
      },
      "oneOf": [
        {
          "required": [
            "field"
          ],
          "not": {
            "required": [
              "path"
            ]
          }
        },
        {
          "required": [
            "path"
          ],
          "not": {
            "required": [
              "field"
            ]
          }
        }
      ]
    }
  }
}
