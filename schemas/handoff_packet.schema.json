{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/stereosurfer/agent-safe-dev-governance-kit/schemas/handoff_packet.schema.json",
  "title": "ASGK handoff packet and compact projection",
  "type": "object",
  "properties": {
    "positive_case": {
      "type": "object"
    },
    "negative_case": {
      "type": "object"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "materialString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "not": {
        "anyOf": [
          {
            "pattern": "^\\s*(?:[Pp][Ee][Nn][Dd][Ii][Nn][Gg]|[Uu][Nn][Kk][Nn][Oo][Ww][Nn]|[Tt][Oo][Dd][Oo]|[Tt][Bb][Dd]|[Nn][Oo][Nn][Ee]|[Nn][Uu][Ll][Ll]|[Nn][.]*\\/?[.]*[Aa]|[Nn][Oo][Tt][\\s_.-]*[Aa][Pp][Pp][Ll][Ii][Cc][Aa][Bb][Ll][Ee])[.!?,:;]*\\s*$"
          },
          {
            "pattern": "[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F\\u00AD\\u061C\\u180E\\u200B-\\u200F\\u202A-\\u202E\\u2060-\\u206F\\uD800-\\uDFFF\\uFEFF\\uFFF9-\\uFFFB]"
          }
        ]
      }
    },
    "materialStringList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/materialString"
      }
    },
    "validationStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "evidence",
        "reason"
      ],
      "properties": {
        "status": {
          "enum": [
            "pass",
            "fail",
            "blocked",
            "not_run"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/materialStringList"
        },
        "reason": {
          "$ref": "#/$defs/materialString"
        }
      }
    },
    "currentStatusImpact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason",
        "current_status_updated_in_this_pr",
        "post_merge_safe",
        "follow_up_issue"
      ],
      "properties": {
        "status": {
          "enum": [
            "updated",
            "not_applicable",
            "deferred"
          ]
        },
        "reason": {
          "$ref": "#/$defs/materialString"
        },
        "current_status_updated_in_this_pr": {
          "type": "boolean"
        },
        "post_merge_safe": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "const": "not_applicable"
            }
          ]
        },
        "follow_up_issue": {
          "type": "string",
          "pattern": "^(?:none|#[0-9]+)(?![\\s\\S])"
        }
      }
    },
    "core": {
      "type": "object",
      "required": [
        "active_issue",
        "active_pr",
        "durable_source_of_truth",
        "branch",
        "objective",
        "current_state",
        "remaining",
        "allowed_paths",
        "modified_files",
        "non_goals",
        "must_not_do",
        "must_read",
        "validation_status",
        "blockers",
        "next_safe_action"
      ],
      "properties": {
        "active_issue": {
          "$ref": "#/$defs/materialString"
        },
        "active_pr": {
          "$ref": "#/$defs/materialString"
        },
        "durable_source_of_truth": {
          "$ref": "#/$defs/materialStringList"
        },
        "branch": {
          "$ref": "#/$defs/materialString"
        },
        "objective": {
          "$ref": "#/$defs/materialString"
        },
        "current_state": {
          "$ref": "#/$defs/materialString"
        },
        "remaining": {
          "$ref": "#/$defs/materialStringList"
        },
        "allowed_paths": {
          "$ref": "#/$defs/materialStringList"
        },
        "modified_files": {
          "$ref": "#/$defs/materialStringList"
        },
        "non_goals": {
          "$ref": "#/$defs/materialStringList"
        },
        "must_not_do": {
          "$ref": "#/$defs/materialStringList"
        },
        "must_read": {
          "$ref": "#/$defs/materialStringList"
        },
        "validation_status": {
          "$ref": "#/$defs/validationStatus"
        },
        "blockers": {
          "$ref": "#/$defs/materialStringList"
        },
        "next_safe_action": {
          "$ref": "#/$defs/materialString"
        }
      }
    }
  },
  "oneOf": [
    {
      "required": [
        "handoff_packet"
      ],
      "not": {
        "required": [
          "compact_handoff"
        ]
      },
      "properties": {
        "handoff_packet": {
          "allOf": [
            {
              "$ref": "#/$defs/core"
            }
          ],
          "unevaluatedProperties": false
        }
      }
    },
    {
      "required": [
        "compact_handoff"
      ],
      "not": {
        "required": [
          "handoff_packet"
        ]
      },
      "properties": {
        "compact_handoff": {
          "allOf": [
            {
              "$ref": "#/$defs/core"
            },
            {
              "type": "object",
              "required": [
                "current_status_impact"
              ],
              "properties": {
                "current_status_impact": {
                  "$ref": "#/$defs/currentStatusImpact"
                }
              }
            }
          ],
          "unevaluatedProperties": false
        }
      }
    }
  ]
}
