{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ASGK Merge Decision Record",
  "type": "object",
  "required": [
    "issue",
    "lane",
    "intelligence_level",
    "durable_source_of_truth",
    "checks_passed",
    "allowed_paths_checked",
    "expected_output_checked",
    "contracts_checked",
    "schemas_checked",
    "storage_boundary",
    "runtime_artifact_boundary",
    "safety_review",
    "human_gates_checked",
    "result",
    "reason"
  ],
  "properties": {
    "checks_passed": {
      "oneOf": [
        {"type": "boolean"},
        {"const": "pending"}
      ]
    },
    "allowed_paths_checked": {"const": true},
    "expected_output_checked": {"const": true},
    "human_gates_checked": {
      "oneOf": [
        {"type": "boolean"},
        {"const": "pending"}
      ]
    },
    "result": {"enum": ["merge_allowed", "merge_blocked"]},
    "reason": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "result": {"const": "merge_allowed"}
        },
        "required": ["result"]
      },
      "then": {
        "properties": {
          "checks_passed": {"const": true},
          "human_gates_checked": {"const": true}
        }
      }
    }
  ],
  "additionalProperties": true
}
